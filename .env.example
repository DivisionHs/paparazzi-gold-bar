# Configurações do Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Configurações do Kommo CRM
KOMMO_SUBDOMAIN=
KOMMO_LONG_LIVED_TOKEN=

# Configurações de Regra de Negócio da Paparazzi
KOMMO_TARGET_TAG=aniversario
# ID da etapa (status_id) do funil de produção que dispara o processamento do lead.
KOMMO_TARGET_STATUS_ID=142

# MODO TESTE (ngrok / "Novo funil teste" no Kommo): quando true, o webhook aceita
# o lead mesmo que o status_id recebido seja diferente de KOMMO_TARGET_STATUS_ID.
# Mantenha "false" em produção.
KOMMO_WEBHOOK_TEST_MODE=false
